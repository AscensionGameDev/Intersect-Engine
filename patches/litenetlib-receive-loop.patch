+        private long _lastReceiveErrorLogTick;
+
+        /// <summary>
+        /// A receive error that repeats on every pass of the loop (typically while the sockets are being closed during
+        /// shutdown) used to spin the thread and write the same stack trace millions of times. Log at most once per
+        /// second and yield the CPU so the loop can never run hot.
+        /// </summary>
+        private void ReportReceiveError(Exception e)
+        {
+            var now = Environment.TickCount64;
+            if (now - _lastReceiveErrorLogTick >= 1000)
+            {
+                _lastReceiveErrorLogTick = now;
+                NetDebug.WriteError("[NM] SocketReceiveThread error: " + e);
+            }
+
+            Thread.Sleep(5);
+        }
+
